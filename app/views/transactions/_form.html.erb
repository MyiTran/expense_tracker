<%= form_with(model: transaction, class: "contents") do |form| %>
  <% if transaction.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(transaction.errors.count, "lỗi") %> khiến giao dịch không được lưu:</h2>
      <ul class="list-disc ml-6">
        <% transaction.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :title, "Tên khoản chi" %>
    <%= form.text_field :title, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": transaction.errors[:title].none?, "border-red-400 focus:outline-red-600": transaction.errors[:title].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :amount, "Số tiền" %>
    <%= form.text_field :amount, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": transaction.errors[:amount].none?, "border-red-400 focus:outline-red-600": transaction.errors[:amount].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :category, "Loại chi tiêu" %>
    <%# Đây là phần thay đổi quan trọng nhất: Chuyển từ number_field sang select %>
    <%= form.select :category, 
        Transaction.categories.keys.map { |k| [k.titleize, k] }, 
        { prompt: "Chọn một loại..." }, 
        class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": transaction.errors[:category].none?, "border-red-400 focus:outline-red-600": transaction.errors[:category].any?}] 
    %>
  </div>

  <div class="my-5">
    <%= form.label :transaction_date, "Ngày giao dịch" %>
    <%= form.date_field :transaction_date, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": transaction.errors[:transaction_date].none?, "border-red-400 focus:outline-red-600": transaction.errors[:transaction_date].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit "Lưu giao dịch", class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>