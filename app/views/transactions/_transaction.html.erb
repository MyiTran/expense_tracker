<div id="<%= dom_id transaction %>" class="bg-white p-5 rounded-2xl border border-gray-100 shadow-sm flex justify-between items-center hover:scale-[1.01] transition-all duration-200">
  <div class="flex items-center gap-4">
    <div class="w-12 h-12 flex items-center justify-center rounded-full text-2xl <%= transaction.food? ? 'bg-orange-100' : (transaction.transport? ? 'bg-blue-100' : 'bg-purple-100') %>">
      <% if transaction.food? %>🍔<% elsif transaction.transport? %>🚗<% elsif transaction.shopping? %>🛍️<% else %>💰<% end %>
    </div>
    
    <div>
      <p class="font-bold text-gray-900 text-lg leading-tight"><%= transaction.title %></p>
      <div class="flex items-center gap-2 mt-1">
        <span class="text-xs font-semibold px-2 py-0.5 rounded bg-gray-100 text-gray-600 uppercase tracking-wider">
          <%= transaction.category.to_s.humanize %>
        </span>
        <span class="text-xs text-gray-400">
          <%= transaction.transaction_date.strftime("%d/%m/%Y") %>
        </span>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-6">
    <div class="text-right">
      <p class="font-black text-gray-900 text-xl">
        - <%= number_to_currency(transaction.amount, unit: "₫", precision: 0, format: "%n %u") %>
      </p>
      <div class="flex justify-end gap-3 mt-1">
        <%= link_to "Sửa", edit_transaction_path(transaction), class: "text-xs font-bold text-blue-500 hover:text-blue-700" %>
        <%= button_to "Xóa", transaction, method: :delete, class: "text-xs font-bold text-red-400 hover:text-red-600", data: { turbo_confirm: "Xóa khoản chi này?" } %>
      </div>
    </div>
  </div>
</div>