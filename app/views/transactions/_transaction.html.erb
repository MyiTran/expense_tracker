<div id="<%= dom_id transaction %>" class="bg-white p-4 rounded-2xl border border-gray-100 shadow-sm flex justify-between items-center group hover:border-indigo-200 transition-all">
  <div class="flex items-center gap-4">
    <div class="w-12 h-12 flex items-center justify-center rounded-2xl text-xl bg-gray-50 group-hover:scale-110 transition-transform">
      <% if transaction.category == "food" %>🍔<% elsif transaction.category == "transport" %>🚗<% else %>💰<% end %>
    </div>
    <div>
      <p class="font-bold text-gray-900"><%= transaction.title %></p>
      <p class="text-xs text-gray-400 font-medium capitalize"><%= transaction.category %> • <%= transaction.transaction_date.strftime("%d/%m/%Y") %></p>
    </div>
  </div>
  <div class="text-right">
    <p class="font-bold text-gray-900">-<%= number_to_currency(transaction.amount, unit: "₫", precision: 0, format: "%n %u") %></p>
    <div class="flex gap-2 justify-end mt-1 opacity-0 group-hover:opacity-100 transition-opacity">
      <%= link_to "Sửa", edit_transaction_path(transaction), class: "text-[10px] uppercase font-bold text-indigo-600" %>
      <%= button_to "Xóa", transaction, method: :delete, class: "text-[10px] uppercase font-bold text-red-400" %>
    </div>
  </div>
</div>